#!/bin/sh
# Runs the convention checks before a commit is written. Text only, so it costs
# a second — it does not build, and a commit that passes here can still fail to
# compile.
#
# Required, not optional: `git config core.hooksPath .githooks` is part of
# setting the repository up, and CI runs the same scripts so a commit that
# bypasses it fails there instead.

root="$(git rev-parse --show-toplevel)"
sh "$root/scripts/check-conventions.sh" || exit 1
exec python3 "$root/scripts/check-references.py"
