namespace CORALean.Real

open Matrix

variable {n : ℕ}


-- =======================================  MAIN THEOREM  ======================================= --

/-- [2, Eq. 2]: the volume of `E(Q, q)` is `V_n √det Q`, for positive-definite `Q`. -/
theorem Ellipsoid.volume_setOf_quad_le {Q : Mat ℝ n n} (hQ : Q.PosDef)
    (q : Vec ℝ n) : -- --- CONCL ---
    MeasureTheory.volume {x : Vec ℝ n | (x - q) ⬝ᵥ Q⁻¹ *ᵥ (x - q) ≤ 1}
      = ENNReal.ofReal (Real.pi ^ ((n : ℝ) / 2) / Real.Gamma ((n : ℝ) / 2 + 1)
          * Real.sqrt Q.det) := by -- --- PROOF ---
  have hset : {x : Vec ℝ n | (x - q) ⬝ᵥ Q⁻¹ *ᵥ (x - q) ≤ 1}
      = (Ellipsoid.ofShape Q q).construct := by
    ext x
    exact (Ellipsoid.mem_ofShape_iff hQ q x).symm
  rw [hset, Ellipsoid.volume_eq _]
  simp only [Ellipsoid.volume]
  rw [Ellipsoid.ofShape_eq hQ.posSemidef]

end CORALean.Real


