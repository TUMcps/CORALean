namespace CORALean.Real

open Matrix
open scoped MatrixOrder

variable {n : ℕ}


-- =======================================  MAIN THEOREM  ======================================= --

/-- The shape of `ofShape Q q` is `Q`, for positive semi-definite `Q`. -/
theorem Ellipsoid.shape_ofShape {Q : Mat ℝ n n} (hQ : Q.PosSemidef) (q : Vec ℝ n) :
    (Ellipsoid.ofShape Q q).shape = Q := by -- --- PROOF ---
  have hN : (CFC.sqrt Q : Mat ℝ n n).IsHermitian := (CFC.sqrt_nonneg Q).posSemidef.isHermitian
  have hNN : (CFC.sqrt Q : Mat ℝ n n) * CFC.sqrt Q = Q := CFC.sqrt_mul_sqrt_self Q hQ.nonneg
  unfold Ellipsoid.shape Ellipsoid.ofShape
  have h := hN.eq
  simp only [conjTranspose_eq_transpose_of_trivial] at h
  show CFC.sqrt Q * (CFC.sqrt Q)ᵀ = Q
  rw [h, hNN]

end CORALean.Real


