module

public import CORALean.ContSet.Ellipsoid.Real.Theorems.GMulTranspose

@[expose] public section

/-!
# `M G` factors `M Q Mᵀ`

`(M G)(M G)ᵀ = M (G Gᵀ) Mᵀ = M Q Mᵀ`, so a linear image of the ellipsoid is generated by `M G`
(`construct_eq_of_factor`), whatever the shape of `M`.

## Inputs
* `M` – matrix
* `E` – ellipsoid

## Hypotheses
* none

## Conclusion
* `M G` has Gram matrix `M Q Mᵀ`
-/

-- Authors:       Claude Opus 5.5
-- Written:       15-October-2026
-- Last update:   ---
-- Reviewed:      ---


-- ----------------------------------------  BEGIN CODE  ---------------------------------------- --

namespace CORALean.Real

open Matrix

variable {n m : ℕ}


-- =======================================  MAIN THEOREM  ======================================= --

/-- `(M G)(M G)ᵀ = M Q Mᵀ`. -/
theorem Ellipsoid.mul_G_mul_transpose (M : Mat ℝ m n) (E : Ellipsoid n) :
    (M * E.G) * (M * E.G)ᵀ = M * E.Q * Mᵀ := by
  rw [Matrix.transpose_mul, Matrix.mul_assoc, ← Matrix.mul_assoc E.G, E.G_mul_transpose,
    ← Matrix.mul_assoc]

end CORALean.Real


-- ---------------------------------------  END OF CODE  ---------------------------------------- --
