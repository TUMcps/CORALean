namespace CORALean.Real

open scoped MatrixOrder

variable {n : ℕ}


-- =====================================  MAIN DEFINITION  ====================================== --

/-- The ellipsoid of centre `q` and shape `Q`, generated by `Q^(1/2)`. -/
noncomputable def Ellipsoid.ofShape (Q : Mat ℝ n n) (q : Vec ℝ n) : Ellipsoid n where
  k := n
  c := q
  G := CFC.sqrt Q

end CORALean.Real


