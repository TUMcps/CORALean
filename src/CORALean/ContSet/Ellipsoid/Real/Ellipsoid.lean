namespace CORALean.Real

open Matrix
open scoped MatrixOrder

variable {n : ℕ}


-- ========================================  MAIN TYPE  ========================================= --

structure Ellipsoid (n : ℕ) where
  /-- The shape matrix. -/
  Q : Mat ℝ n n
  /-- The center. -/
  q : Vec ℝ n
  /-- CORA's constructor checks this, up to its tolerance `TOL`. -/
  psd : Q.PosSemidef

/-- The generator matrix `Q^(1/2)`, CORA's `sqrtm(Q)`: symmetric, and `G G = Q`. -/
noncomputable def Ellipsoid.G (E : Ellipsoid n) : Mat ℝ n n := CFC.sqrt E.Q

def Ellipsoid.construct (E : Ellipsoid n) : Set (Vec ℝ n) :=
  {x | ∃ u : Vec ℝ n, ‖u‖₂ ≤ 1 ∧ x = E.q + E.G *ᵥ u}

end CORALean.Real


