namespace CORALean.Real

variable {α : Type} [AddCommGroup α] [Module ℝ α]


-- ----------------------------------------  AUXILIARY  ----------------------------------------- --

/-- Coefficients pinned off the annihilated generators split into the face's center and a point
of the face's generators. -/
theorem Zonotope.aux_sum_split_face (Z : Zonotope α) (u : α →ₗ[ℝ] ℝ) (β : Fin Z.h → ℝ)
    (hpin : ∀ j, u (Z.G j) ≠ 0 → β j = Real.sign (u (Z.G j))) : -- --- CONCL ---
    Z.c + ∑ j, β j • Z.G j = (Z.face u).c + ∑ j, β j • (Z.face u).G j := by -- --- PROOF ---
  have hterm : ∀ j, β j • Z.G j
      = Real.sign (u (Z.G j)) • Z.G j + β j • (Z.face u).G j := fun j => by
    by_cases hj : u (Z.G j) = 0
    · simp [Zonotope.face, hj]
    · simp [Zonotope.face, hj, hpin j hj]
  rw [Finset.sum_congr rfl fun j _ => hterm j, Finset.sum_add_distrib, ← add_assoc]
  rfl


-- =======================================  MAIN THEOREM  ======================================= --

/-- [1, Sec. 3 (faces)]: the face of `Z` maximizing `u` is the zonotope `Z.face u`. -/
theorem Zonotope.construct_face (Z : Zonotope α) (u : α →ₗ[ℝ] ℝ) : -- --- CONCL ---
    (Z.face u).construct =
      {x | x ∈ Z.construct ∧ ∀ y ∈ Z.construct, u y ≤ u x} := by -- --- PROOF ---
  ext x
  rw [Z.mem_argmax_iff u x]
  constructor
  · -- a face point: free coefficients kept, the pinned ones set to their signs
    rintro ⟨γ, hγ, rfl⟩
    refine ⟨fun j => if u (Z.G j) = 0 then γ j else Real.sign (u (Z.G j)), fun j => ?_,
      fun j hj => by simp [hj], ?_⟩
    · by_cases hj : u (Z.G j) = 0
      · simpa [hj] using hγ j
      · simp only [hj, if_false]
        rcases Real.sign_apply_eq (u (Z.G j)) with h | h | h <;> rw [h] <;> simp
    · rw [Z.aux_sum_split_face u _ fun j hj => by simp [hj]]
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      by_cases hj : u (Z.G j) = 0 <;> simp [Zonotope.face, hj]
  · rintro ⟨β, hβ, hpin, rfl⟩
    exact ⟨β, hβ, Z.aux_sum_split_face u β hpin⟩

end CORALean.Real


