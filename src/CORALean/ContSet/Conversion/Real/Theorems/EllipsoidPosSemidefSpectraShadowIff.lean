namespace CORALean.Real

open CORALean Matrix

variable {n : ℕ}


-- ----------------------------------------  AUXILIARY  ----------------------------------------- --

/-- The inequality's matrix `A₀ + Σᵢ uᵢ Aᵢ`, spelt at its size `n + 1`. -/
private def aux_M (Q : Mat ℝ n n) (q u : Vec ℝ n) : Mat ℝ (n + 1) (n + 1) :=
  (Matrix.of fun p r =>
    Fin.cases (Fin.cases 1 (fun j => -q j) r) (fun i => Fin.cases (-q i) (fun j => Q i j) r) p)
  + ∑ i, u i • Matrix.of fun p r =>
    if (p = 0 ∧ r = i.succ) ∨ (p = i.succ ∧ r = 0) then (1 : ℝ) else 0

/-- The inequality's matrix entry by entry: `1`, `y = u - q` on the border, `Q` inside. -/
private theorem aux_M_apply (Q : Mat ℝ n n) (q u : Vec ℝ n) (p r : Fin (n + 1)) :
    aux_M Q q u p r = Fin.cases (Fin.cases 1 (fun j => u j - q j) r)
      (fun i => Fin.cases (u i - q i) (fun j => Q i j) r) p := by -- --- PROOF ---
  simp only [aux_M, Matrix.add_apply, Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul,
    Matrix.of_apply]
  rcases Fin.eq_zero_or_eq_succ p with rfl | ⟨i, rfl⟩ <;>
    rcases Fin.eq_zero_or_eq_succ r with rfl | ⟨j, rfl⟩
  · simp [(Fin.succ_ne_zero _).symm]
  · simp [Fin.succ_ne_zero, Fin.succ_inj, eq_comm (a := j)]
    ring
  · simp [Fin.succ_ne_zero, Fin.succ_inj]
    ring
  · simp [Fin.succ_ne_zero]

/-- The quadratic form at `(a, z)`: `a² + 2a (y·z) + zᵀ Q z`. -/
private theorem aux_M_form (Q : Mat ℝ n n) (q u : Vec ℝ n) (x : Fin (n + 1) → ℝ) :
    x ⬝ᵥ (aux_M Q q u *ᵥ x)
      = x 0 ^ 2 + 2 * x 0 * ((u - q) ⬝ᵥ fun i => x i.succ)
        + (fun i => x i.succ) ⬝ᵥ (Q *ᵥ fun i => x i.succ) := by -- --- PROOF ---
  simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_succ, aux_M_apply, Fin.cases_zero,
    Fin.cases_succ, Pi.sub_apply]
  simp only [mul_add, Finset.mul_sum, Finset.sum_add_distrib]
  have e1 : ∑ i : Fin n, x 0 * ((u i - q i) * x i.succ)
      = ∑ i : Fin n, x i.succ * ((u i - q i) * x 0) :=
    Finset.sum_congr rfl fun _ _ => by ring
  have e2 : ∑ i : Fin n, 2 * x 0 * ((u i - q i) * x i.succ)
      = ∑ i : Fin n, x 0 * ((u i - q i) * x i.succ)
        + ∑ i : Fin n, x i.succ * ((u i - q i) * x 0) := by
    rw [← e1, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun _ _ => by ring
  rw [e2]
  ring

/-- `(y·z)² ≤ zᵀ Q z` for every `z` is the point `q + y` in the ellipsoid. -/
theorem Ellipsoid.aux_sq_le_iff (E : Ellipsoid n) (y : Vec ℝ n) :
    (∀ z : Vec ℝ n, (y ⬝ᵥ z) ^ 2 ≤ z ⬝ᵥ (E.Q *ᵥ z)) ↔ E.q + y ∈ E.construct := by -- --- PROOF ---
  rw [Ellipsoid.mem_construct_iff]
  have hGG : E.G * E.G = E.Q := by
    have h := E.G_mul_transpose
    rwa [E.G_transpose] at h
  have hGz : ∀ z : Vec ℝ n, z ⬝ᵥ (E.Q *ᵥ z) = (E.G *ᵥ z) ⬝ᵥ (E.G *ᵥ z) := fun z => by
    rw [← hGG, ← mulVec_mulVec, dotProduct_mulVec, ← mulVec_transpose, E.G_transpose,
      dotProduct_comm]
  constructor
  · -- `y yᵀ ⪯ Q`, and `y` generates the ellipsoid of `y yᵀ`
    intro h
    have hpsd : (vecMulVec y y).PosSemidef := by
      simpa using Matrix.posSemidef_vecMulVec_self_star y
    have hle : (E.Q - vecMulVec y y).PosSemidef := by
      refine Matrix.PosSemidef.of_dotProduct_mulVec_nonneg ?_ fun z => ?_
      · exact E.psd.isHermitian.sub hpsd.isHermitian
      · simp only [star_trivial, Matrix.sub_mulVec, dotProduct_sub]
        have hz : z ⬝ᵥ (vecMulVec y y *ᵥ z) = (y ⬝ᵥ z) ^ 2 := by
          simp only [Matrix.mulVec, vecMulVec_apply, dotProduct, Finset.mul_sum, sq,
            Finset.sum_mul]
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
        rw [hz]
        linarith [h z]
    -- the ellipsoid of `y yᵀ` inside `E`, and `y` its own point
    have hsub := Ellipsoid.construct_subset_of_le (E₁ := ⟨vecMulVec y y, E.q, hpsd⟩) (E₂ := E)
      hle rfl
    refine Ellipsoid.mem_construct_iff.1 (hsub ?_)
    have hF : (Matrix.of fun i (_ : Fin 1) => y i) * (Matrix.of fun i (_ : Fin 1) => y i)ᵀ
        = vecMulVec y y := by
      ext i j
      simp [Matrix.mul_apply, vecMulVec_apply]
    rw [Ellipsoid.construct_eq_of_factor _ _ hF]
    refine ⟨fun _ => 1, by simp [norm₂], ?_⟩
    funext i
    simp [Matrix.mulVec, dotProduct]
  · -- Cauchy–Schwarz against `G z`
    rintro ⟨w, hw, hyw⟩
    have hy : y = E.G *ᵥ w := by
      have := congrArg (· - E.q) hyw
      simpa using this
    intro z
    have hdot : y ⬝ᵥ z = w ⬝ᵥ (E.G *ᵥ z) := by
      rw [hy, dotProduct_comm, dotProduct_mulVec, ← mulVec_transpose, E.G_transpose,
        dotProduct_comm]
    rw [hdot, hGz, dotProduct_self]
    have hcs := abs_dotProduct_le_norm₂_mul_norm₂ w (E.G *ᵥ z)
    have h1 : ‖w‖₂ * ‖E.G *ᵥ z‖₂ ≤ ‖E.G *ᵥ z‖₂ :=
      mul_le_of_le_one_left (norm₂_nonneg _) hw
    rw [← sq_abs]
    exact pow_le_pow_left₀ (abs_nonneg _) (hcs.trans h1) 2


-- =======================================  MAIN THEOREM  ======================================= --

/-- The Schur form at `u` is positive semi-definite iff `u` is a point of the ellipsoid. -/
theorem Ellipsoid.posSemidef_spectraShadow_iff (E : Ellipsoid n) (u : Vec ℝ n) :
    (E.spectraShadow.A₀ + ∑ i, u i • E.spectraShadow.A i).PosSemidef ↔ u ∈ E.construct
    := by -- --- PROOF ---
  change (aux_M E.Q E.q u).PosSemidef ↔ _
  have hu : u = E.q + (u - E.q) := by abel
  rw [hu, ← Ellipsoid.aux_sq_le_iff]
  rw [← hu]
  set y := u - E.q with hy
  -- symmetric, `Q` being so
  have hherm : (aux_M E.Q E.q u).IsHermitian := by
    refine Matrix.IsHermitian.ext fun p r => ?_
    simp only [star_trivial, aux_M_apply]
    have hQ : ∀ i j, E.Q i j = E.Q j i := fun i j => by
      have h := E.psd.isHermitian.eq
      simp only [conjTranspose_eq_transpose_of_trivial] at h
      exact (congrFun (congrFun h j) i)
    rcases Fin.eq_zero_or_eq_succ p with rfl | ⟨i, rfl⟩ <;>
      rcases Fin.eq_zero_or_eq_succ r with rfl | ⟨j, rfl⟩ <;> simp [hQ]
  constructor
  · -- the form at `(-(y·z), z)`
    intro h z
    have hz := h.dotProduct_mulVec_nonneg (Fin.cons (-(y ⬝ᵥ z)) z)
    simp only [star_trivial] at hz
    rw [aux_M_form] at hz
    simp only [Fin.cons_zero, Fin.cons_succ] at hz
    have e : (fun i : Fin n => z i) = z := rfl
    rw [e, ← hy] at hz
    nlinarith
  · -- the form is a square plus `zᵀ Q z - (y·z)²`
    intro h
    refine Matrix.PosSemidef.of_dotProduct_mulVec_nonneg hherm fun x => ?_
    simp only [star_trivial]
    rw [aux_M_form]
    have := h fun i => x i.succ
    nlinarith [sq_nonneg (x 0 + y ⬝ᵥ fun i => x i.succ)]

end CORALean.Real


